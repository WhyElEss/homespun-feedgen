FEEDGEN_PORT=3000

# 0.0.0.0 is required so the cloudflared container can reach the service
FEEDGEN_LISTENHOST="0.0.0.0"

# Path inside the container; ./data is mounted to /data by docker-compose
FEEDGEN_SQLITE_LOCATION="/data/db.sqlite"

# Jetstream instead of the raw firehose. Official public instances:
#   jetstream1.us-east.bsky.network   jetstream2.us-east.bsky.network
#   jetstream1.us-west.bsky.network   jetstream2.us-west.bsky.network
# If your feed suddenly serves stale posts, the INSTANCE may be lagging —
# run `node scripts/probeJetstream.js` and switch to a healthy one.
FEEDGEN_SUBSCRIPTION_ENDPOINT="wss://jetstream1.us-east.bsky.network"

# The hostname your feed will be served from (via Cloudflare Tunnel)
FEEDGEN_HOSTNAME="feed.example.com"

# DID of your Bluesky account (the feed's publisher). Find it:
# https://bsky.social/xrpc/com.atproto.identity.resolveHandle?handle=YOUR_HANDLE
FEEDGEN_PUBLISHER_DID="did:plc:XXXXXXXXXXXXXXXXXXXXXXXX"

# Service identity. Recommended: the same did:plc as the publisher
# (run `yarn setupServiceDid` once to add the #bsky_fg service entry).
FEEDGEN_SERVICE_DID="did:plc:XXXXXXXXXXXXXXXXXXXXXXXX"

# Record key of the feed = the "shortname" in its URL.
# New feed: pick one (letters/digits/dashes), use the same when publishing.
# Migrating from SkyFeed: MUST be the rkey of the existing record.
FEEDGEN_SHORTNAME="my-feed"

# Optional: avatar image for migrateFeed/restoreFeed (path inside container)
# FEEDGEN_AVATAR_PATH="/data/avatar.png"

FEEDGEN_SUBSCRIPTION_RECONNECT_DELAY=3000

# Cloudflare Tunnel token (Networking -> Tunnels -> your tunnel -> Docker;
# copy ONLY the long string after --token)
TUNNEL_TOKEN="ey..."
