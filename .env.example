FEEDGEN_PORT=3000

# 0.0.0.0 is required so the cloudflared container can reach the service
FEEDGEN_LISTENHOST="0.0.0.0"

# Path inside the container; ./data is mounted to /data by docker-compose
FEEDGEN_SQLITE_LOCATION="/data/db.sqlite"

# Jetstream instead of the raw firehose. Official public instances:
#   jetstream1.us-east.bsky.network   jetstream2.us-east.bsky.network
#   jetstream1.us-west.bsky.network   jetstream2.us-west.bsky.network
# If your feed suddenly serves stale posts, the INSTANCE may be lagging —
# run `node scripts/probeJetstream.js` and switch to a healthy one.
FEEDGEN_SUBSCRIPTION_ENDPOINT="wss://jetstream1.us-east.bsky.network"

# The hostname your feed will be served from (via Cloudflare Tunnel)
FEEDGEN_HOSTNAME="feed.example.com"

# DID of your Bluesky account (the feed's publisher). Find it:
# https://bsky.social/xrpc/com.atproto.identity.resolveHandle?handle=YOUR_HANDLE
FEEDGEN_PUBLISHER_DID="did:plc:XXXXXXXXXXXXXXXXXXXXXXXX"

# Service identity. Recommended: the same did:plc as the publisher
# (run `yarn setupServiceDid` once to add the #bsky_fg service entry).
FEEDGEN_SERVICE_DID="did:plc:XXXXXXXXXXXXXXXXXXXXXXXX"

# Which feeds this service runs is NOT set here — it comes from the "feeds"
# object in data/filters.json, whose keys are the record keys (rkeys) you
# publish the feeds under. See filters.example.json.
#
# FEEDGEN_SHORTNAME is legacy. Keep it ONLY if you are upgrading an install
# that predates multi-feed support: the 002 database migration files your
# existing rows under this name, and a legacy single-feed filters.json is
# read as a feed with this key. New installs can leave it unset.
# FEEDGEN_SHORTNAME="my-feed"

FEEDGEN_SUBSCRIPTION_RECONNECT_DELAY=3000

# ── Admin UI ────────────────────────────────────────────────────────────────
# A password-protected status page at /admin ON THE PUBLIC APP — the same app
# the tunnel points at. Off unless FEEDGEN_ADMIN_UI is "on".
#
# Generate the hash with `yarn adminPassword`; it prints these two lines. With
# the UI on and the hash missing or malformed the service REFUSES TO START,
# because the alternative is an unauthenticated admin page on a public host.
#
# On a STANDBY box leave both unset: it runs the same image and answers on its
# own hostname, so a copied .env publishes a second login page.
# FEEDGEN_ADMIN_UI="on"
# FEEDGEN_ADMIN_PASSWORD_HASH="scrypt$16384$8$1$...$..."

# Which box you are looking at, and whether it is the one whose config may be
# edited. Today FEEDGEN_ADMIN_MODE only labels the box; write endpoints will
# require "rw" when they exist. Defaults: the hostname, and "readonly".
# FEEDGEN_BOX_NAME="pi"
# FEEDGEN_ADMIN_MODE="readonly"

# Unrelated to the UI: a loopback-only read/validate API for tooling on the box,
# reached over an SSH tunnel. Absent unless the port is set.
# FEEDGEN_ADMIN_PORT=3001
# FEEDGEN_ADMIN_HOST="127.0.0.1"

# Only if your account does NOT live on bsky.social: the PDS the record-editing
# scripts log in to and read blobs from. Defaults to https://bsky.social.
# PDS_URL="https://pds.example.com"

# Cloudflare Tunnel token (Networking -> Tunnels -> your tunnel -> Docker;
# copy ONLY the long string after --token)
TUNNEL_TOKEN="ey..."
