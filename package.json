{
  "name": "homespun-feedgen",
  "version": "1.0.0",
  "description": "Self-hosted Bluesky feed generator for small boxes (Raspberry Pi): Jetstream, SQLite, hot-reloadable JSON filters, Cloudflare Tunnel — with a SkyFeed migration kit",
  "main": "index.js",
  "repository": "git@github.com:WhyElEss/homespun-feedgen.git",
  "author": "dholms <dtholmgren@gmail.com>",
  "license": "MIT",
  "scripts": {
    "publishFeed": "ts-node scripts/publishFeedGen.ts",
    "unpublishFeed": "ts-node scripts/unpublishFeedGen.ts",
    "setupServiceDid": "ts-node scripts/setupServiceDid.ts",
    "start": "ts-node src/index.ts",
    "build": "tsc",
    "whyNot": "ts-node scripts/whyNot.ts",
    "purgePosts": "ts-node scripts/purgePosts.ts",
    "test:filters": "FEEDGEN_FILTERS_PATH=./filters.example.json ts-node scripts/testFilter.ts",
    "repointFeed": "ts-node scripts/repointFeed.ts",
    "restoreFeed": "ts-node scripts/restoreFeed.ts",
    "setFeedAvatar": "ts-node scripts/setFeedAvatar.ts",
    "setFeedDescription": "ts-node scripts/setFeedDescription.ts",
    "checkMigration": "ts-node scripts/checkMigration.ts",
    "adminPassword": "ts-node scripts/adminPassword.ts",
    "adminTotp": "ts-node scripts/adminTotp.ts",
    "test:gc": "ts-node scripts/testGc.ts",
    "test:adminqr": "ts-node scripts/testAdminQr.ts",
    "test:admintotp": "ts-node scripts/testAdminTotp.ts",
    "test:adminauth": "FEEDGEN_FILTERS_PATH=/tmp/adminauth-test-filters.json ts-node scripts/testAdminAuth.ts",
    "test:adminwrite": "FEEDGEN_FILTERS_PATH=/tmp/adminwrite-test-filters.json ts-node scripts/testAdminWrite.ts",
    "test:pinned": "FEEDGEN_FILTERS_PATH=/tmp/pinned-test-filters.json ts-node scripts/testPinned.ts",
    "test:validate": "FEEDGEN_FILTERS_PATH=./filters.example.json ts-node scripts/testValidate.ts",
    "test:subscription": "FEEDGEN_FILTERS_PATH=/tmp/sub-test-filters.json ts-node scripts/testSubscription.ts",
    "test:admin": "ts-node scripts/testAdmin.ts",
    "test:adminpage": "ts-node scripts/testAdminPage.ts"
  },
  "dependencies": {
    "@atproto/api": "^0.13.28",
    "@atproto/identity": "^0.2.1",
    "@atproto/lexicon": "^0.2.2",
    "@atproto/repo": "^0.3.2",
    "@atproto/syntax": "^0.1.2",
    "@atproto/xrpc-server": "^0.7.9",
    "better-sqlite3": "^11.3.0",
    "dotenv": "^16.0.3",
    "express": "^4.18.2",
    "kysely": "^0.27.4",
    "multiformats": "^9.9.0",
    "qrcode-generator": "^2.0.4",
    "ws": "^8.21.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/express": "^4.17.17",
    "@types/node": "^20.1.2",
    "@types/ws": "^8.18.1",
    "inquirer": "^12.0.1",
    "ts-node": "^10.9.1",
    "typescript": "^5.0.4"
  },
  "engines": {
    "node": ">= 18",
    "yarn": "1"
  },
  "packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e"
}
